# ===== Supabase (Database + Đăng nhập admin) =====
# Lấy tại: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ===== Cloudinary (Lưu + tối ưu ảnh) =====
# Lấy tại: Cloudinary Console → Dashboard (Product Environment Credentials)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxx
# Thư mục lưu ảnh trên Cloudinary (tuỳ chọn)
CLOUDINARY_FOLDER=makeup-portfolio

# ===== Resend (Gửi email form liên hệ) =====
# Lấy tại: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxx
# Email nhận thông báo đặt lịch (email của chủ sở hữu)
CONTACT_TO_EMAIL=you@example.com
# Email gửi đi. Gói free chưa xác minh domain thì dùng onboarding@resend.dev
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# ===== Site =====
# URL công khai của trang (dùng cho sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Khoá bí mật để GitHub Action gọi /api/keep-alive (tự đặt chuỗi ngẫu nhiên)
KEEP_ALIVE_SECRET=change-me
